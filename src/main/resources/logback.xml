<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- =====================================================
         Rolling file appender — keeps 30 days of logs
         Location: C:\Users\<You>\.propertymanager\logs\
         ===================================================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.propertymanager/logs/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.propertymanager/logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- =====================================================
         Console appender — visible in the VS Code terminal
         ===================================================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- =====================================================
         Root logger — INFO and above go to both appenders
         ===================================================== -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Quiet down noisy library logs we don't need -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb"     level="INFO"/>

</configuration>
