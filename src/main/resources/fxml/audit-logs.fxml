<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.AuditLogController"
           styleClass="content-pane">

    <VBox spacing="18">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Audit Logs" styleClass="page-title"/>
                <Label text="Every important action recorded in the system"
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton"
                    text="Refresh"
                    styleClass="button"
                    onAction="#handleRefresh"/>
        </HBox>

        <!-- Info strip -->
        <HBox spacing="10"
              style="-fx-background-color: rgba(201,162,74,0.08); -fx-background-radius: 8; -fx-padding: 12 16 12 16;">
            <Label text="Note:"
                   style="-fx-font-weight: bold; -fx-text-fill: -fx-gold-deep;"/>
            <Label text="Audit logs are read-only. They record who did what, and when. Use them to trace activity or investigate issues."
                   styleClass="label-muted"
                   wrapText="true"/>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField"
                       promptText="Search by user, action, entity or description..."
                       prefWidth="380"/>
            <ComboBox fx:id="actionFilter"
                      promptText="Action"
                      prefWidth="200"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel"
                   text="0 events"
                   styleClass="label-muted"/>
        </HBox>

        <!-- Table -->
        <StackPane VBox.vgrow="ALWAYS" minHeight="0">
            <TableView fx:id="logsTable" styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="whenColumn"        text="WHEN"        prefWidth="160" minWidth="140"/>
                    <TableColumn fx:id="userColumn"        text="USER"        prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="actionColumn"      text="ACTION"      prefWidth="200" minWidth="160"/>
                    <TableColumn fx:id="entityColumn"      text="ENTITY"      prefWidth="160" minWidth="120"/>
                    <TableColumn fx:id="descriptionColumn" text="DETAIL"      prefWidth="320" minWidth="200"/>
                </columns>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="10"
                  visible="false"
                  managed="false">
                <Label text="NO ACTIVITY YET"
                       styleClass="section-title"/>
                <Label text="Actions performed in the system will be recorded here."
                       styleClass="label-muted"/>
            </VBox>
        </StackPane>

    </VBox>

</StackPane>
