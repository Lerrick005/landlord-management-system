<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.TenantListController"
           styleClass="content-pane">

    <VBox spacing="18">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Tenants" styleClass="page-title"/>
                <Label text="Register and manage all tenants"
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="registerTenantButton"
                    text="Register Tenant"
                    styleClass="button-primary"
                    onAction="#handleRegisterTenant"/>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField"
                       promptText="Search by name, ID number, phone or tenant number..."
                       prefWidth="380"/>
            <ComboBox fx:id="statusFilter"
                      promptText="Status"
                      prefWidth="140"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel"
                   text="0 tenants"
                   styleClass="label-muted"/>
        </HBox>

        <!-- Table -->
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="tenantsTable" styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="tenantNumberColumn" text="TENANT NO." prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="fullNameColumn"     text="FULL NAME"   prefWidth="200" minWidth="150"/>
                    <TableColumn fx:id="phoneColumn"        text="PHONE"       prefWidth="140" minWidth="120"/>
                    <TableColumn fx:id="nationalIdColumn"   text="ID NUMBER"   prefWidth="130" minWidth="110"/>
                    <TableColumn fx:id="roomColumn"         text="ROOM"        prefWidth="80"  minWidth="60"/>
                    <TableColumn fx:id="statusColumn"       text="STATUS"      prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="actionsColumn"      text="ACTIONS"     prefWidth="340" minWidth="320"/>
                </columns>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="NO TENANTS YET"
                       styleClass="section-title"/>
                <Label text="Register your first tenant to get started."
                       styleClass="label-muted"/>
                <Button fx:id="emptyRegisterButton"
                        text="Register Tenant"
                        styleClass="button-primary"
                        onAction="#handleRegisterTenant"/>
            </VBox>
        </StackPane>

    </VBox>

</StackPane>
