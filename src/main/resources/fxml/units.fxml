<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.UnitListController"
           styleClass="content-pane">

    <VBox spacing="18">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Back link -->
        <Button fx:id="backButton"
                text="Back to Properties"
                styleClass="button-ghost"
                onAction="#handleBack"/>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label fx:id="pageTitleLabel"
                       text="Rooms"
                       styleClass="page-title"/>
                <Label fx:id="pageSubtitleLabel"
                       text=""
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newRoomButton"
                    text="New Room"
                    styleClass="button-primary"
                    onAction="#handleNewRoom"/>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField"
                       promptText="Search room number..."
                       prefWidth="280"/>
            <ComboBox fx:id="statusFilter"
                      promptText="Status"
                      prefWidth="140"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel"
                   text="0 rooms"
                   styleClass="label-muted"/>
        </HBox>

        <!-- Table -->
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="unitsTable" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="houseNumberColumn" text="ROOM NUMBER" prefWidth="130"/>
                    <TableColumn fx:id="typeColumn"        text="TYPE"        prefWidth="150"/>
                    <TableColumn fx:id="rentColumn"        text="MONTHLY RENT" prefWidth="140"/>
                    <TableColumn fx:id="depositColumn"     text="DEPOSIT"     prefWidth="140"/>
                    <TableColumn fx:id="statusColumn"      text="STATUS"      prefWidth="110"/>
                    <TableColumn fx:id="actionsColumn"     text="ACTIONS"     prefWidth="220"/>
                </columns>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="NO ROOMS YET"
                       styleClass="section-title"/>
                <Label text="Add your first room to this property."
                       styleClass="label-muted"/>
                <Button fx:id="emptyNewRoomButton"
                        text="Add Room"
                        styleClass="button-primary"
                        onAction="#handleNewRoom"/>
            </VBox>
        </StackPane>

    </VBox>

</StackPane>
