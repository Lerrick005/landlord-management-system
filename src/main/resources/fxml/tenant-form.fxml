<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.propertymanager.controller.TenantFormController"
      styleClass="content-pane"
      spacing="0"
      prefWidth="560"
      prefHeight="640"
      maxHeight="640"
      minHeight="480">

    <!-- Header (fixed) -->
    <VBox styleClass="topbar" spacing="4">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>
        <Label fx:id="headerLabel"
               text="Register Tenant"
               styleClass="page-title"/>
        <Label fx:id="subHeaderLabel"
               text="Enter the tenant's details below."
               styleClass="page-subtitle"/>
    </VBox>

    <!-- Body — scrollable, shrinks to make room for footer -->
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                minHeight="200"
                styleClass="form-scroll">
        <content>
            <VBox spacing="14">
                <padding>
                    <Insets top="22" right="24" bottom="20" left="24"/>
                </padding>

                <!-- Full name -->
                <VBox spacing="6">
                    <Label text="Full Name *" styleClass="field-label"/>
                    <TextField fx:id="fullNameField"
                               promptText="e.g. John Kamau"/>
                    <Label fx:id="fullNameError"
                           styleClass="field-error-message"
                           visible="false" managed="false"/>
                </VBox>

                <!-- National ID + Phone -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="National ID / Passport *" styleClass="field-label"/>
                        <TextField fx:id="nationalIdField"
                                   promptText="e.g. 12345678"/>
                        <Label fx:id="nationalIdError"
                               styleClass="field-error-message"
                               visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Phone Number *" styleClass="field-label"/>
                        <TextField fx:id="phoneField"
                                   promptText="e.g. 0712 345 678"/>
                        <Label fx:id="phoneError"
                               styleClass="field-error-message"
                               visible="false" managed="false"/>
                    </VBox>
                </HBox>

                <!-- Alt phone + Email -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Alternative Phone" styleClass="field-label"/>
                        <TextField fx:id="altPhoneField"
                                   promptText="Optional"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Email" styleClass="field-label"/>
                        <TextField fx:id="emailField"
                                   promptText="Optional"/>
                        <Label fx:id="emailError"
                               styleClass="field-error-message"
                               visible="false" managed="false"/>
                    </VBox>
                </HBox>

                <!-- Next of kin + phone -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Next of Kin" styleClass="field-label"/>
                        <TextField fx:id="nextOfKinField"
                                   promptText="Optional"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Next of Kin Phone" styleClass="field-label"/>
                        <TextField fx:id="nextOfKinPhoneField"
                                   promptText="Optional"/>
                    </VBox>
                </HBox>

                <!-- Occupation + Status -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Occupation" styleClass="field-label"/>
                        <TextField fx:id="occupationField"
                                   promptText="Optional"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="160">
                        <Label text="Status" styleClass="field-label"/>
                        <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Assign Room section -->
                <VBox fx:id="assignRoomSection" spacing="14">

                    <Region prefHeight="1"
                            maxWidth="Infinity"
                            style="-fx-background-color: -fx-grey-200;"/>

                    <VBox spacing="2">
                        <Label text="Assign Room (optional)"
                               styleClass="section-title"/>
                        <Label text="Leave blank to register the tenant without a room."
                               styleClass="label-muted"/>
                    </VBox>

                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Property" styleClass="field-label"/>
                            <ComboBox fx:id="propertyCombo" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Room" styleClass="field-label"/>
                            <ComboBox fx:id="roomCombo" maxWidth="Infinity"/>
                            <Label fx:id="roomHintLabel"
                                   text=""
                                   styleClass="label-muted"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Move-in Date" styleClass="field-label"/>
                            <DatePicker fx:id="moveInDatePicker" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Monthly Rent (KSh)" styleClass="field-label"/>
                            <TextField fx:id="rentField"
                                       promptText="Auto-filled from room"/>
                            <Label fx:id="rentError"
                                   styleClass="field-error-message"
                                   visible="false" managed="false"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Deposit Paid (KSh)" styleClass="field-label"/>
                            <TextField fx:id="depositField"
                                       promptText="Optional"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Inline error -->
                <Label fx:id="formError"
                       styleClass="field-error-message"
                       wrapText="true"
                       visible="false" managed="false"/>

            </VBox>
        </content>
    </ScrollPane>

    <!-- Footer (fixed, always visible) -->
    <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel"
                styleClass="button"
                onAction="#handleCancel"
                cancelButton="true"/>
        <Button fx:id="saveButton"
                text="Register Tenant"
                styleClass="button-primary"
                onAction="#handleSave"
                defaultButton="true"/>
    </HBox>

</VBox>
