<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.propertymanager.controller.UserFormController"
      styleClass="content-pane"
      spacing="0"
      prefWidth="480">

    <!-- Header -->
    <VBox styleClass="topbar" spacing="4">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>
        <Label fx:id="headerLabel"
               text="Add User"
               styleClass="page-title"/>
        <Label fx:id="subHeaderLabel"
               text="Create a new account for this system"
               styleClass="page-subtitle"/>
    </VBox>

    <!-- Form body -->
    <VBox spacing="14">
        <padding>
            <Insets top="22" right="24" bottom="20" left="24"/>
        </padding>

        <!-- Username -->
        <VBox spacing="6">
            <Label text="Username *" styleClass="field-label"/>
            <TextField fx:id="usernameField"
                       promptText="e.g. mary"/>
            <Label fx:id="usernameError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Full name -->
        <VBox spacing="6">
            <Label text="Full Name *" styleClass="field-label"/>
            <TextField fx:id="fullNameField"
                       promptText="e.g. Mary Wanjiku"/>
            <Label fx:id="fullNameError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Role -->
        <VBox spacing="6">
            <Label text="Role *" styleClass="field-label"/>
            <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>
            <Label text="Administrator: full access. Manager: daily operations. Accountant: payments and reports."
                   styleClass="label-muted"
                   wrapText="true"/>
            <Label fx:id="roleError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Password section (create mode only) -->
        <VBox fx:id="passwordSection" spacing="14">
            <Region prefHeight="1"
                    maxWidth="Infinity"
                    style="-fx-background-color: -fx-grey-200;"/>

            <VBox spacing="2">
                <Label text="Password" styleClass="section-title"/>
                <Label text="Minimum 8 characters, at least one letter and one number."
                       styleClass="label-muted"
                       wrapText="true"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password *" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter password"/>
                <Label fx:id="passwordError"
                       styleClass="field-error-message"
                       visible="false" managed="false"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Confirm Password *" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Re-enter password"/>
                <Label fx:id="confirmPasswordError"
                       styleClass="field-error-message"
                       visible="false" managed="false"/>
            </VBox>
        </VBox>

        <!-- Inline error -->
        <Label fx:id="formError"
               styleClass="field-error-message"
               wrapText="true"
               visible="false" managed="false"/>

    </VBox>

    <!-- Footer with buttons -->
    <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel"
                styleClass="button"
                onAction="#handleCancel"
                cancelButton="true"/>
        <Button fx:id="saveButton"
                text="Add User"
                styleClass="button-primary"
                onAction="#handleSave"
                defaultButton="true"/>
    </HBox>

</VBox>
