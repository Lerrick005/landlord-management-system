<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.propertymanager.controller.PaymentFormController"
      styleClass="content-pane"
      spacing="0"
      prefWidth="560"
      prefHeight="620"
      maxHeight="620"
      minHeight="480">

    <!-- Header (fixed) -->
    <VBox styleClass="topbar" spacing="4">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>
        <Label text="Record Payment"
               styleClass="page-title"/>
        <Label text="Enter the payment details below."
               styleClass="page-subtitle"/>
    </VBox>

    <!-- Body — scrollable -->
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                minHeight="200"
                styleClass="form-scroll">
        <content>
            <VBox spacing="14">
                <padding>
                    <Insets top="22" right="24" bottom="20" left="24"/>
                </padding>

                <!-- Tenant -->
                <VBox spacing="6">
                    <Label text="Tenant *" styleClass="field-label"/>
                    <ComboBox fx:id="tenantCombo" maxWidth="Infinity"/>
                    <Label fx:id="tenantError"
                           styleClass="field-error-message"
                           visible="false" managed="false"/>
                    <Label fx:id="tenantHintLabel"
                           text=""
                           styleClass="label-muted"/>
                </VBox>

                <!-- Amount + Date -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Amount (KSh) *" styleClass="field-label"/>
                        <TextField fx:id="amountField"
                                   promptText="e.g. 8000"/>
                        <Label fx:id="amountError"
                               styleClass="field-error-message"
                               visible="false" managed="false"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Payment Date *" styleClass="field-label"/>
                        <DatePicker fx:id="paymentDatePicker" maxWidth="Infinity"/>
                        <Label fx:id="paymentDateError"
                               styleClass="field-error-message"
                               visible="false" managed="false"/>
                    </VBox>
                </HBox>

                <!-- For Month + Year -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="For Month *" styleClass="field-label"/>
                        <ComboBox fx:id="monthCombo" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6" prefWidth="120">
                        <Label text="Year *" styleClass="field-label"/>
                        <ComboBox fx:id="yearCombo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Method -->
                <VBox spacing="6">
                    <Label text="Payment Method *" styleClass="field-label"/>
                    <ComboBox fx:id="methodCombo" maxWidth="Infinity"/>
                </VBox>

                <!-- Reference -->
                <VBox spacing="6">
                    <Label text="Reference / Transaction Number" styleClass="field-label"/>
                    <TextField fx:id="referenceField"
                               promptText="e.g. M-Pesa code QWE12345"/>
                    <Label fx:id="referenceError"
                           styleClass="field-error-message"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Notes -->
                <VBox spacing="6">
                    <Label text="Notes" styleClass="field-label"/>
                    <TextArea fx:id="notesArea"
                              promptText="Optional notes"
                              prefRowCount="2"
                              wrapText="true"/>
                </VBox>

                <!-- Inline error -->
                <Label fx:id="formError"
                       styleClass="field-error-message"
                       wrapText="true"
                       visible="false" managed="false"/>

            </VBox>
        </content>
    </ScrollPane>

    <!-- Footer (fixed, always visible) -->
    <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel"
                styleClass="button"
                onAction="#handleCancel"
                cancelButton="true"/>
        <Button fx:id="saveButton"
                text="Record Payment"
                styleClass="button-primary"
                onAction="#handleSave"
                defaultButton="true"/>
    </HBox>

</VBox>
