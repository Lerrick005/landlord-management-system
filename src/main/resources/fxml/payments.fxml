<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.PaymentListController"
           styleClass="content-pane">

    <VBox spacing="18">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Payments" styleClass="page-title"/>
                <Label text="Record and view rent payments"
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="recordPaymentButton"
                    text="Record Payment"
                    styleClass="button-primary"
                    onAction="#handleRecordPayment"/>
        </HBox>

        <!-- Summary strip -->
        <HBox spacing="16" styleClass="card">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <VBox spacing="2">
                <Label text="THIS MONTH COLLECTED" styleClass="stat-card-title"/>
                <Label fx:id="monthCollectedLabel"
                       text="KSh 0"
                       styleClass="stat-card-value-gold"/>
            </VBox>

            <Region prefWidth="24"/>

            <VBox spacing="2">
                <Label text="PAYMENTS THIS MONTH" styleClass="stat-card-title"/>
                <Label fx:id="monthCountLabel"
                       text="0"
                       styleClass="stat-card-value"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox spacing="2" alignment="CENTER_RIGHT">
                <Label text="TOTAL RECORDS" styleClass="stat-card-title"/>
                <Label fx:id="totalCountLabel"
                       text="0"
                       styleClass="stat-card-value"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField"
                       promptText="Search by tenant, receipt or reference..."
                       prefWidth="380"/>
            <ComboBox fx:id="periodFilter"
                      promptText="Period"
                      prefWidth="180"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel"
                   text="0 payments"
                   styleClass="label-muted"/>
        </HBox>

        <!-- Table -->
        <StackPane VBox.vgrow="ALWAYS" minHeight="0">
            <TableView fx:id="paymentsTable" styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="receiptColumn" text="RECEIPT NO." prefWidth="140" minWidth="130"/>
                    <TableColumn fx:id="dateColumn"    text="DATE"        prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="tenantColumn"  text="TENANT"      prefWidth="180" minWidth="150"/>
                    <TableColumn fx:id="roomColumn"    text="ROOM"        prefWidth="80"  minWidth="60"/>
                    <TableColumn fx:id="periodColumn"  text="FOR MONTH"   prefWidth="140" minWidth="120"/>
                    <TableColumn fx:id="amountColumn"  text="AMOUNT"      prefWidth="120" minWidth="110"/>
                    <TableColumn fx:id="methodColumn"  text="METHOD"      prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="statusColumn"  text="STATUS"      prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="actionsColumn" text="ACTIONS"     prefWidth="200" minWidth="180"/>
                </columns>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="NO PAYMENTS YET"
                       styleClass="section-title"/>
                <Label text="Record your first payment to get started."
                       styleClass="label-muted"/>
                <Button fx:id="emptyRecordButton"
                        text="Record Payment"
                        styleClass="button-primary"
                        onAction="#handleRecordPayment"/>
            </VBox>
        </StackPane>

    </VBox>

</StackPane>
