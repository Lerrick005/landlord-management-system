<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.LoginController"
           styleClass="login-root"
           prefWidth="900" prefHeight="600">

    <HBox>

        <!-- ============================================================
             LEFT - brand panel
             ============================================================ -->
        <VBox styleClass="login-left-panel"
              prefWidth="380"
              alignment="CENTER_LEFT"
              spacing="20">

            <Region prefHeight="30"/>

            <!-- Logo placeholder - replace with ImageView later -->
            <StackPane style="-fx-background-color: -fx-gold; -fx-background-radius: 12; -fx-min-width: 64; -fx-min-height: 64; -fx-max-width: 64; -fx-max-height: 64;">
                <Label text="PM" style="-fx-text-fill: -fx-charcoal-deep; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </StackPane>

            <Label text="Property Management"
                   styleClass="login-brand-title"/>

            <Label text="TENANT &amp; RENT SYSTEM"
                   styleClass="login-brand-tagline"/>

            <Region prefHeight="20"/>

            <Label text="Manage properties, tenants, rent,&#10;payments and balances - all offline,&#10;all in one place."
                   styleClass="login-brand-description"
                   wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="v1.0.0"
                   styleClass="login-brand-description"/>

        </VBox>

        <!-- ============================================================
             RIGHT - form panel
             ============================================================ -->
        <VBox styleClass="login-right-panel"
              HBox.hgrow="ALWAYS"
              alignment="CENTER"
              spacing="0">

            <VBox maxWidth="380" spacing="18">

                <Label text="Welcome back"
                       styleClass="login-title"/>

                <Label text="Sign in to continue to your dashboard."
                       styleClass="login-subtitle"/>

                <Region prefHeight="10"/>

                <!-- Username -->
                <VBox spacing="6">
                    <Label text="Username" styleClass="field-label"/>
                    <TextField fx:id="usernameField"
                               promptText="Enter your username"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="6">
                    <Label text="Password" styleClass="field-label"/>
                    <StackPane>
                        <PasswordField fx:id="passwordField"
                                       promptText="Enter your password"/>
                        <TextField fx:id="passwordVisibleField"
                                   promptText="Enter your password"
                                   visible="false"
                                   managed="false"/>
                        <Button fx:id="togglePasswordButton"
                                text="Show"
                                styleClass="button-ghost"
                                StackPane.alignment="CENTER_RIGHT"
                                focusTraversable="false"
                                translateX="-4"/>
                    </StackPane>
                </VBox>

                <!-- Remember / status row -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <CheckBox fx:id="rememberUsernameCheck"
                              text="Remember username"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Error message -->
                <Label fx:id="errorLabel"
                       styleClass="field-error-message"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <!-- Submit -->
                <StackPane>
                    <Button fx:id="loginButton"
                            text="Sign In"
                            styleClass="button-primary, button-block"
                            onAction="#handleLogin"
                            defaultButton="true"/>
                    <ProgressIndicator fx:id="loginProgress"
                                       visible="false"
                                       managed="false"
                                       maxWidth="20" maxHeight="20"
                                       StackPane.alignment="CENTER_RIGHT"
                                       translateX="-10"/>
                </StackPane>

                <Region prefHeight="6"/>

                <Label text="Contact your administrator if you have forgotten your password."
                       styleClass="label-muted"
                       wrapText="true"/>

            </VBox>

        </VBox>

    </HBox>

</StackPane>
