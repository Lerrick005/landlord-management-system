<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.SetupWizardController"
           styleClass="login-root"
           prefWidth="820"
           prefHeight="640">

    <VBox maxWidth="700"
          maxHeight="620"
          styleClass="card"
          spacing="0">

        <!-- Header -->
        <VBox spacing="6" alignment="CENTER">
            <padding>
                <Insets top="28" right="32" bottom="20" left="32"/>
            </padding>

            <Label text="Welcome"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: -fx-charcoal;"/>
            <Label text="Let's set up your property management system"
                   styleClass="page-subtitle"/>
        </VBox>

        <!-- Gold divider -->
        <Region prefHeight="1"
                maxWidth="Infinity"
                style="-fx-background-color: -fx-gold;"/>

        <!-- Scrollable body -->
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    minHeight="0"
                    styleClass="form-scroll">
            <content>
                <VBox spacing="18">
                    <padding>
                        <Insets top="24" right="32" bottom="24" left="32"/>
                    </padding>

                    <!-- Card 1: Administrator -->
                    <VBox spacing="12"
                          style="-fx-background-color: -fx-off-white; -fx-background-radius: 8; -fx-padding: 18;">

                        <VBox spacing="2">
                            <Label text="1.  Administrator Account" styleClass="section-title"/>
                            <Label text="This is your login. You can add additional users later."
                                   styleClass="label-muted"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Full Name *" styleClass="field-label"/>
                            <TextField fx:id="adminFullNameField"
                                       promptText="e.g. John Kamau"/>
                            <Label fx:id="adminFullNameError"
                                   styleClass="field-error-message"
                                   visible="false" managed="false"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Username *" styleClass="field-label"/>
                            <TextField fx:id="adminUsernameField"
                                       promptText="e.g. admin (lowercase, no spaces)"/>
                            <Label fx:id="adminUsernameError"
                                   styleClass="field-error-message"
                                   visible="false" managed="false"/>
                        </VBox>

                        <HBox spacing="14">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Password *" styleClass="field-label"/>
                                <PasswordField fx:id="adminPasswordField"
                                               promptText="Min 8 chars, letter + number"/>
                                <Label fx:id="adminPasswordError"
                                       styleClass="field-error-message"
                                       visible="false" managed="false"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Confirm Password *" styleClass="field-label"/>
                                <PasswordField fx:id="adminConfirmField"
                                               promptText="Re-enter password"/>
                                <Label fx:id="adminConfirmError"
                                       styleClass="field-error-message"
                                       visible="false" managed="false"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 2: Organization -->
                    <VBox spacing="12"
                          style="-fx-background-color: -fx-off-white; -fx-background-radius: 8; -fx-padding: 18;">

                        <VBox spacing="2">
                            <Label text="2.  Organization" styleClass="section-title"/>
                            <Label text="This appears on receipts and reports."
                                   styleClass="label-muted"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Organization Name *" styleClass="field-label"/>
                            <TextField fx:id="orgNameField"
                                       promptText="e.g. Green Eden Hostel"/>
                            <Label fx:id="orgNameError"
                                   styleClass="field-error-message"
                                   visible="false" managed="false"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Address" styleClass="field-label"/>
                            <TextField fx:id="orgAddressField"
                                       promptText="e.g. Karatina, Nyeri County"/>
                        </VBox>

                        <HBox spacing="14">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Phone" styleClass="field-label"/>
                                <TextField fx:id="orgPhoneField"
                                           promptText="e.g. 0712 345 678"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="orgEmailField"
                                           promptText="e.g. info@example.com"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Currency Code *" styleClass="field-label"/>
                                <TextField fx:id="currencyCodeField"
                                           promptText="e.g. KES"/>
                            </VBox>

                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Currency Symbol *" styleClass="field-label"/>
                                <TextField fx:id="currencySymbolField"
                                           promptText="e.g. KSh"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Form error -->
                    <Label fx:id="formError"
                           styleClass="field-error-message"
                           wrapText="true"
                           visible="false" managed="false"/>

                </VBox>
            </content>
        </ScrollPane>

        <!-- Footer -->
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-background-color: -fx-off-white; -fx-padding: 16 32 16 32; -fx-background-radius: 0 0 8 8;">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="completeButton"
                    text="Complete Setup"
                    styleClass="button-primary"
                    onAction="#handleComplete"
                    defaultButton="true"
                    prefWidth="200"
                    prefHeight="40"
                    style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        </HBox>

    </VBox>

</StackPane>
