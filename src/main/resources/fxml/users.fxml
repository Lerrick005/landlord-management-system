<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.propertymanager.controller.UserListController"
           styleClass="content-pane">

    <VBox spacing="18">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>

        <!-- Page header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4">
                <Label text="Users" styleClass="page-title"/>
                <Label text="Manage accounts that can log into this system"
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="newUserButton"
                    text="Add User"
                    styleClass="button-primary"
                    onAction="#handleNewUser"/>
        </HBox>

        <!-- Info strip -->
        <HBox spacing="10"
              style="-fx-background-color: rgba(201,162,74,0.08); -fx-background-radius: 8; -fx-padding: 12 16 12 16;">
            <Label text="Info:"
                   style="-fx-font-weight: bold; -fx-text-fill: -fx-gold-deep;"/>
            <Label text="Most landlords only need one admin account. Add extra users only for assistants, spouses, or accountants."
                   styleClass="label-muted"
                   wrapText="true"/>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="searchField"
                       promptText="Search by username or full name..."
                       prefWidth="320"/>
            <ComboBox fx:id="roleFilter"
                      promptText="Role"
                      prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel"
                   text="0 users"
                   styleClass="label-muted"/>
        </HBox>

        <!-- Table -->
        <StackPane VBox.vgrow="ALWAYS" minHeight="0">
            <TableView fx:id="usersTable" styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="usernameColumn" text="USERNAME"   prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="nameColumn"     text="FULL NAME"  prefWidth="200" minWidth="150"/>
                    <TableColumn fx:id="roleColumn"     text="ROLE"       prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="statusColumn"   text="STATUS"     prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="actionsColumn"  text="ACTIONS"    prefWidth="300" minWidth="280"/>
                </columns>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="NO USERS YET"
                       styleClass="section-title"/>
                <Label text="Add your first user to get started."
                       styleClass="label-muted"/>
                <Button fx:id="emptyNewUserButton"
                        text="Add User"
                        styleClass="button-primary"
                        onAction="#handleNewUser"/>
            </VBox>
        </StackPane>

    </VBox>

</StackPane>
