<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.propertymanager.controller.MainController"
            styleClass="content-pane"
            prefWidth="1200" prefHeight="760">

    <!-- Top bar -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="pageTitleLabel"
                   text="Dashboard"
                   styleClass="topbar-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT" spacing="0">
                <Label fx:id="userNameLabel"
                       text="User"
                       styleClass="topbar-user"/>
                <Label fx:id="userRoleLabel"
                       text="Role"
                       styleClass="topbar-role"/>
            </VBox>

            <StackPane styleClass="topbar-avatar">
                <Label fx:id="avatarInitialsLabel"
                       text="U"
                       styleClass="topbar-avatar-text"/>
            </StackPane>

            <Region prefWidth="6"/>

            <Button fx:id="changePasswordButton"
                    text="Change Password"
                    styleClass="button"
                    onAction="#handleChangePassword"
                    focusTraversable="false"/>

            <Button text="Logout"
                    styleClass="button"
                    onAction="#handleLogout"/>

            <Region prefWidth="8"/>

            <Button fx:id="minimizeButton"
                    text="—"
                    styleClass="window-control"
                    onAction="#handleMinimize"
                    focusTraversable="false"/>
            <Button fx:id="maximizeButton"
                    text="▢"
                    styleClass="window-control"
                    onAction="#handleMaximize"
                    focusTraversable="false"/>
            <Button fx:id="closeButton"
                    text="✕"
                    styleClass="window-control-close"
                    onAction="#handleClose"
                    focusTraversable="false"/>
        </HBox>
    </top>

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="210">

            <!-- Brand -->
            <VBox styleClass="sidebar-header" spacing="2">
                <Label text="Property Manager"
                       styleClass="sidebar-brand"/>
                <Label text="TENANT &amp; RENT SYSTEM"
                       styleClass="sidebar-brand-sub"/>
            </VBox>

            <Region prefHeight="6"/>

            <Label text="MAIN" styleClass="sidebar-section-label"/>

            <!-- Navigation items -->
            <Button fx:id="navDashboard"
                    text="Dashboard"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navProperties"
                    text="Properties"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navTenants"
                    text="Tenants"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navPayments"
                    text="Payments"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navReports"
                    text="Reports"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>

            <Label text="ADMIN" styleClass="sidebar-section-label"/>

            <Button fx:id="navUsers"
                    text="Users"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navAuditLogs"
                    text="Audit Logs"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>
            <Button fx:id="navSettings"
                    text="Settings"
                    styleClass="sidebar-item"
                    onAction="#navigate"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="navLogout"
                    text="Logout"
                    styleClass="sidebar-item"
                    onAction="#handleLogout"/>

            <Region prefHeight="12"/>
        </VBox>
    </left>

    <!-- Center content (swapped by controller) -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-pane"/>
    </center>

</BorderPane>
