<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.propertymanager.controller.ChangePasswordController"
      styleClass="content-pane"
      spacing="0"
      prefWidth="440">

    <!-- Header -->
    <VBox styleClass="topbar" spacing="4">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>
        <Label text="Change Password"
               styleClass="page-title"/>
        <Label fx:id="subHeaderLabel"
               text="Change your account password"
               styleClass="page-subtitle"/>
    </VBox>

    <!-- Body -->
    <VBox spacing="14">
        <padding>
            <Insets top="22" right="24" bottom="20" left="24"/>
        </padding>

        <!-- Current password -->
        <VBox spacing="6">
            <Label text="Current Password *" styleClass="field-label"/>
            <PasswordField fx:id="currentPasswordField"
                           promptText="Enter your current password"/>
            <Label fx:id="currentPasswordError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- New password -->
        <VBox spacing="6">
            <Label text="New Password *" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField"
                           promptText="Enter new password"/>
            <Label fx:id="newPasswordError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Confirm -->
        <VBox spacing="6">
            <Label text="Confirm New Password *" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Re-enter new password"/>
            <Label fx:id="confirmPasswordError"
                   styleClass="field-error-message"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Policy hint -->
        <Label text="Minimum 8 characters, at least one letter and one number."
               styleClass="label-muted"
               wrapText="true"/>

        <!-- Form error -->
        <Label fx:id="formError"
               styleClass="field-error-message"
               wrapText="true"
               visible="false" managed="false"/>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel"
                styleClass="button"
                onAction="#handleCancel"
                cancelButton="true"/>
        <Button fx:id="saveButton"
                text="Change Password"
                styleClass="button-primary"
                onAction="#handleSave"
                defaultButton="true"/>
    </HBox>

</VBox>
