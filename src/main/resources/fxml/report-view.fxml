<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.propertymanager.controller.ReportViewerController"
      styleClass="content-pane"
      spacing="0"
      minHeight="400"
      prefHeight="700">

    <!-- ============================================================
         HEADER
         ============================================================ -->
    <VBox styleClass="topbar" spacing="4">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>
        <Label fx:id="titleLabel"
               text="Report"
               styleClass="page-title"/>
        <Label fx:id="subtitleLabel"
               text=""
               styleClass="page-subtitle"/>
    </VBox>

    <!-- ============================================================
         FILTER BAR (only visible when the report supports filters)
         ============================================================ -->
    <HBox fx:id="filterBar"
          alignment="CENTER_LEFT"
          spacing="12"
          style="-fx-background-color: -fx-off-white; -fx-padding: 12 24 12 24; -fx-border-color: transparent transparent -fx-grey-200 transparent; -fx-border-width: 0 0 1 0;">

        <Label text="Filter:"
               styleClass="field-label"
               fx:id="filterLabel"/>

        <!-- Month + Year for period-filtered reports -->
        <ComboBox fx:id="monthFilter"
                  promptText="Month"
                  prefWidth="140"
                  visible="false"
                  managed="false"/>

        <ComboBox fx:id="yearFilter"
                  promptText="Year"
                  prefWidth="100"
                  visible="false"
                  managed="false"/>

        <!-- Date range for payment report -->
        <DatePicker fx:id="fromDatePicker"
                    promptText="From"
                    prefWidth="160"
                    visible="false"
                    managed="false"/>

        <Label text="to"
               fx:id="dateRangeSeparator"
               styleClass="label-muted"
               visible="false"
               managed="false"/>

        <DatePicker fx:id="toDatePicker"
                    promptText="To"
                    prefWidth="160"
                    visible="false"
                    managed="false"/>

        <Button fx:id="applyButton"
                text="Apply"
                styleClass="button-primary"
                onAction="#handleApplyFilters"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="rowCountLabel"
               text=""
               styleClass="label-muted"/>
    </HBox>

    <!-- ============================================================
         TABLE (shrinks to fill remaining space, min 0)
         ============================================================ -->
    <StackPane VBox.vgrow="ALWAYS"
               minHeight="0"
               maxHeight="Infinity">
        <padding>
            <Insets top="18" right="24" bottom="18" left="24"/>
        </padding>

        <TableView fx:id="reportTable" styleClass="table-view">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Empty state -->
        <VBox fx:id="emptyState"
              alignment="CENTER"
              spacing="10"
              visible="false"
              managed="false">
            <Label text="NO DATA"
                   styleClass="section-title"/>
            <Label text="There is nothing to show for the selected filters."
                   styleClass="label-muted"/>
        </VBox>
    </StackPane>

    <!-- ============================================================
         FOOTER — action buttons
         ============================================================ -->
    <HBox styleClass="topbar" alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="14" right="24" bottom="14" left="24"/>
        </padding>
        <Label fx:id="generatedOnLabel"
               text=""
               styleClass="label-muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="printButton"
                text="Print"
                styleClass="button"/>
        <Button fx:id="exportExcelButton"
                text="Export Excel"
                styleClass="button"/>
        <Button fx:id="exportPdfButton"
                text="Export PDF"
                styleClass="button-burgundy"/>
        <Button fx:id="closeButton"
                text="Close"
                styleClass="button-primary"
                onAction="#handleClose"
                defaultButton="true"
                cancelButton="true"/>
    </HBox>

</VBox>
